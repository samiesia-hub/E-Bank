{
  "info": {
    "name": "E-Bank API",
    "description": "Parcours complet de l'API E-Bank avec les trois roles.\n\n1. Ouvrir l'environnement « E-Bank - local » (baseUrl = http://localhost:8090).\n2. Executer le dossier « 1. Authentification » : les jetons admin/client/support sont enregistres dans les variables.\n3. Executer les autres dossiers dans l'ordre.\n\nLes comptes de demonstration proviennent du seed (pro/src/main/resources/db/demo/seed-demo.sql).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "compteId",
      "value": "2001"
    },
    {
      "key": "clientId",
      "value": "1005"
    },
    {
      "key": "reclamationId",
      "value": "4001"
    }
  ],
  "item": [
    {
      "name": "1. Authentification",
      "item": [
        {
          "name": "Login ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const corps = pm.response.json();",
                  "pm.test('role ADMIN', () => pm.expect(corps.role).to.eql('ADMIN'));",
                  "pm.test('jeton present', () => pm.expect(corps.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('adminToken', corps.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin.demo1@demo.orabank.test\",\n  \"motDePasse\": \"Admin1234!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Enregistre le jeton dans {{adminToken}}."
          }
        },
        {
          "name": "Login CLIENT",
